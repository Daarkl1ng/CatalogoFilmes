@startuml
hide circle
skinparam linetype ortho

entity "filmes" as filmes {
    * id : INT <<PK, AUTO_INCREMENT>>
    --
    titulo : VARCHAR(255) <<NOT NULL>>
    diretor : VARCHAR(255) <<NOT NULL>>
    ano_lancamento : INT <<NOT NULL>>
    genero : VARCHAR(100) <<NOT NULL>>
    sinopse : TEXT <<NULL>>
}

@enduml